__pycache__/
*.pyc
.ipynb_checkpoints/
.venv/
venv/

# Raw collector snapshots (timestamped, one new file per run) fully regenerate
# from the FPL API and data/raw/*/entry/ holds a manager's personal history/
# picks -- keep all of data/raw/ out of git. The dashboard's pre-season/manual
# squad modes need a bootstrap snapshot at deploy time, but Streamlit Cloud has
# no way to run the collector itself -- so a single, STABLE (non-timestamped)
# copy lives at data/dashboard_bootstrap.json instead (see below), committed
# deliberately and refreshed by hand/CI, decoupled from data/raw/'s
# ever-growing timestamped files.
data/raw/

# A manager's own manually-entered squad (player-id list only, saved so a
# browser refresh doesn't silently discard it) -- personal, not league-wide
# data, so kept out of git same as data/raw/'s manager-entry history.
data/manual_squad.json

# data/dashboard_entry_history.json (NOT matched by data/raw/ above, since
# it's a different path) is a deliberately-committed, non-timestamped copy of
# ONE specific manager's (this project's own) past-season history.json, for
# the same reason data/dashboard_bootstrap.json exists: Streamlit Cloud can't
# run the collector, so the Manager History tab needs a fallback at deploy
# time. Not a new privacy decision -- this exact data is already published on
# the public manager-history GitHub Pages page linked throughout the app.

# Processed data is normally gitignored (regenerates via load_historical.py +
# features.py against the vaastav dataset), EXCEPT features.parquet and
# historical_gw.parquet, which the dashboard depends on directly and Streamlit
# Cloud has no way to regenerate (that needs a local clone of a separate repo
# at a hardcoded path) -- committed deliberately so the deployed app has data
# to read. ~14MB combined, no personal data (league-wide historical stats only).
data/processed/*
!data/processed/features.parquet
!data/processed/historical_gw.parquet
!data/processed/.gitkeep
models/*.pkl
models/*.joblib
models/*.txt
# Except the trained single-stage xP model itself: the dashboard's
# historical-mode tools (Squad Builder/Transfers/Chip Advisor) load it
# directly for predicted_points, and Streamlit Cloud has no way to run
# train.py itself -- same "committed deliberately, no personal data" pattern
# as data/dashboard_bootstrap.json above. ~1.4MB. The play-classifier and
# points-given-played files stay ignored -- only the single-stage model is
# actually used at inference time (see train.py's two-stage negative result).
!models/xp_model_single_stage.txt
