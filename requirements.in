# Top-level dependency ranges -- the source of truth for what this project
# WANTS. Bump versions here first, then re-resolve the exact pins in
# requirements.txt (pip install -r requirements.in && pip freeze, reviewed by
# hand against the notes on numpy's Python floor).
#
# requirements.txt is what actually gets installed everywhere (CI, Streamlit
# Cloud, local dev) -- it is pinned on purpose, so a fresh deploy can never
# silently pick up a new major than the one that was tested.
pandas>=3.0.6
numpy>=1.24
scikit-learn>=1.3
lightgbm>=4.0
pulp>=2.7
# Floor is the oldest release verified against this code: st.dataframe's
# width="stretch" (which replaced the deprecated use_container_width) has to
# exist in whatever gets installed.
streamlit>=1.64.0
pytest>=9.1.1
